# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/govinnovate_sih

# DigiLocker / API Setu Requester Configuration
# Set to 'mock' for SIH demonstration or 'production' for live API Setu credentials
DIGILOCKER_MODE=mock

# Official API Setu / DigiLocker Production Credentials
DIGILOCKER_CLIENT_ID=your_api_setu_client_id_here
DIGILOCKER_CLIENT_SECRET=your_api_setu_client_secret_here
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/digilocker/callback
DIGILOCKER_AUTHORIZATION_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in/public/oauth2/1
